[Unit]
Description=Vorot - Camera & Gate Control
After=network-online.target
Wants=network-online.target

[Service]
WorkingDirectory=/opt/camera-control
ExecStart=/usr/bin/python3 /opt/camera-control/camera_control.py
# Порт веб-інтерфейсу (за замовчуванням 8080)
Environment=LISTEN_PORT=8080
# Робота за nginx у підтеці - див. deploy/nginx-subfolder.conf
#Environment=URL_PREFIX=/vorot
#Environment=LISTEN_HOST=127.0.0.1
#Environment=TRUST_PROXY=1
# При нестачі пам'яті ядро/earlyoom вбивають цей процес останнім
OOMScoreAdjust=-500
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
